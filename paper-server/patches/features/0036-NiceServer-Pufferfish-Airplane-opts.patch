diff --git a/net/minecraft/world/level/chunk/LevelChunk.java b/net/minecraft/world/level/chunk/LevelChunk.java
--- a/net/minecraft/world/level/chunk/LevelChunk.java
+++ b/net/minecraft/world/level/chunk/LevelChunk.java
@@ -130,6 +130,17 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
     private final int maxSection;
     private final boolean debug;
     private final BlockState defaultBlockState;
+    // NiceServer start - Pufferfish lightning
+    private int lightningTick;
+
+    public final boolean shouldDoLightning(final net.minecraft.util.RandomSource random) {
+        if (this.lightningTick-- <= 0) {
+            this.lightningTick = random.nextInt(Math.max(1, this.level.spigotConfig.thunderChance)) << 1;
+            return true;
+        }
+        return false;
+    }
+    // NiceServer end - Pufferfish lightning
 
